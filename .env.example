# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Public base URL of the web app. Used to build links inside emails.
APP_URL=http://localhost:5173
# Number of reverse proxies in front of the API, so req.ip is the real client
# rather than the load balancer. Set to "false" when nothing proxies the API.
TRUST_PROXY=1
# Requests allowed per IP per 15 minutes across all of /api. Counted in Redis,
# so it is shared across instances and survives restarts.
RATE_LIMIT_MAX=1000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/starter_kit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=starter_kit
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Admin seeder ─────────────────────────────────────────────────────────────
# Leave ADMIN_PASSWORD empty locally and the seeder generates a random one and
# prints it once. It is required when seeding with NODE_ENV=production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ─── OpenAI (optional) ────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Cheap/fast model used for AI habit suggestions. Defaults to gpt-4o-mini if unset.
OPENAI_SUGGESTIONS_MODEL=gpt-4o-mini
# Minutes a user must wait between AI habit-suggestion generations. Defaults to 60 if unset.
AI_SUGGESTIONS_COOLDOWN_MINUTES=30

# ─── Email (optional) ─────────────────────────────────────────────────────────
# "resend" | "brevo" | "console". Leave empty to auto-detect from the API keys
# below, falling back to "console" (emails are logged, not sent) in local dev.
EMAIL_PROVIDER=
# Resend free tier: 3,000 emails/month, 100/day, one verified sending domain.
# Until a domain is verified you can only mail your own Resend account address.
RESEND_API_KEY=
# Brevo free tier: 300 emails/day from a single verified sender address —
# the better choice if you don't own a domain yet.
BREVO_API_KEY=
EMAIL_FROM=Kultivar <onboarding@resend.dev>

# ─── Re-engagement ────────────────────────────────────────────────────────────
# Set to "false" to stop the daily sweep that emails lapsed users.
REENGAGEMENT_ENABLED=true

# ─── Storage / S3 (optional) ──────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
